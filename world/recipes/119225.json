  "instructions": [
    "Combine crabmeat , monterey jack cheese , mozzarella cheese , cheddar cheese , 1 / 4 cup cocktail sauce , green onions and garlic in medium bowl",
    "Mix well",
    "Spread about 1 / 2 cup mixture onto 2 tortillas",
    "Sprinkle evenly with remaining monterey jack cheese",
    "Top with remaining tortillas",
    "Melt 1 tablespoons butter on cast iron griddle over medium-high heat",
    "Add one quesadilla",
    "Cook for 2 minutes on each side or until golden brown",
    "Repeat",
    "Cut each into eight wedges",
    "Serve with cocktail sauce for dipping"
